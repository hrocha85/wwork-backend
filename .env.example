APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Cookie do PWA. No Mac, localhost chega nos dois ports. Em produção, o domínio
# partilhado (ex. .wwork.upbase.com.br) e os hosts do Next e da API.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:8000
# SESSION_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Mac (MySQL Remoto): DB_HOST=162.220.61.50
# API em api.wwork.upbase.com.br: DB_HOST=127.0.0.1
DB_HOST=162.220.61.50
DB_PORT=3306
DB_DATABASE=upbase93_wwork
DB_USERNAME=upbase93_wwork
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: log grava o e-mail em storage/logs. Produção (cPanel): smtp com a conta
# do domínio. Porta 465 usa MAIL_SCHEME=smtps. Porta 587 deixa MAIL_SCHEME vazio
# (STARTTLS). Este Laravel não lê MAIL_ENCRYPTION. Teste: php artisan wwork:mail-test voce@exemplo.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="WWork"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe teste: sk_test_ ou rk_test_ só no servidor. Nunca no front nem no git.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
LAUNCH_OFFER_ENDS_AT=2027-03-31

# OneSignal (Keys & IDs). A REST API key fica só no servidor; o front recebe apenas o App ID.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Seed. Não commitar a senha real. Mínimo 8 caracteres.
ADMIN_SEED_PASSWORD=
DEMO_SEED_PASSWORD=
# SEED_DEMO=true
