APP_NAME=WWork
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Londres é o lançamento. Data, hora e o .ics futuro seguem este fuso.
APP_TIMEZONE=Europe/London

# Inglês primeiro. As chaves de pt, pl, ro e es já existem no catálogo do PWA.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

# Moeda única do produto. Valores são gravados em pence inteiros.
WWORK_CURRENCY=GBP

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB online. Não há MySQL local: desenvolvimento e produção falam com este banco.
# Peça host, porta, nome, usuário e senha ao Henrique. Nada disso entra no git.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# A sessão do PWA é cookie, não token. O cookie precisa viver no banco compartilhado.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Em produção, o domínio começa com ponto para o cookie valer em app. e api.:
# SESSION_DOMAIN=.wwork.app
# Em localhost fica vazio: o navegador não separa cookie por porta.
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Hosts que recebem cookie de sessão do Sanctum. O domínio real ainda não foi definido.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000

# Origens do PWA autorizadas no CORS. Curinga não funciona junto de credenciais.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@wwork.app"
MAIL_FROM_NAME="${APP_NAME}"

# Primeiro fundador, criado pelo FounderSeeder para o acesso local ao /admin.
WWORK_FOUNDER_NAME="WWork Founder"
WWORK_FOUNDER_EMAIL=
WWORK_FOUNDER_PASSWORD=
