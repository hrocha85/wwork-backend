<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_TIMEZONE" value="Europe/London"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            A aplicação fala com o MariaDB online. A suíte roda em SQLite na
            memória para nenhum `php artisan test` escrever e apagar linha no
            banco de verdade. Se o Henrique preferir um schema wwork_test no
            MariaDB, é trocar estas duas linhas.
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Simula o PWA em outro host, que é como a sessão em cookie é usada. -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:3000,127.0.0.1,127.0.0.1:3000"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:3000,http://app.wwork.test"/>
        <env name="WWORK_FOUNDER_EMAIL" value="founder@wwork.test"/>
        <env name="WWORK_FOUNDER_PASSWORD" value="founder-secret"/>
    </php>
</phpunit>
